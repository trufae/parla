namespace Dc {

    public enum MarkdownMode {
        ENABLED = 0,
        STRIPPED = 1,
        DISABLED = 2;
    }

    /** Selectable palette family for code-block syntax highlighting. */
    public enum CodeTheme {
        ADAPTIVE = 0,
        SOLARIZED = 1,
        MONOKAI = 2,
        NORD = 3,
        NONE = 4;
    }
}
