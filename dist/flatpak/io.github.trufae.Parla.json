                    "sha256": "62aa375904aeea88f356a20cb5d7bb6b90728f5e14d81c2b0f689c6c7341af2d",
                    "dest-filename": "deltachat-rpc-server",
                    "only-arches": [
                        "x86_64"
                    ],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/chatmail/core/releases/latest",
                        "timestamp-query": ".published_at",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"deltachat-rpc-server-x86_64-linux\") | .browser_download_url"
                    }
                },
                {
                    "type": "file",
                    "url": "https://github.com/chatmail/core/releases/download/v2.62.0/deltachat-rpc-server-aarch64-linux",
                    "sha256": "a81a75e2de356c5b0074100aee655a7a1884dcc747c79e2b57e7b6f4316a70ee",
                    "dest-filename": "deltachat-rpc-server",
                    "only-arches": [
                        "aarch64"
                    ],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/chatmail/core/releases/latest",
                        "timestamp-query": ".published_at",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"deltachat-rpc-server-aarch64-linux\") | .browser_download_url"
                    }
                }
            ]
        },
        {
            "name": "parla",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../.."
                }
            ]
        }
    ]
