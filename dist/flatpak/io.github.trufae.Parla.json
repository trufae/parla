{
    "id": "io.github.trufae.Parla",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "parla",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "modules": [
        {
            "name": "deltachat-rpc-server",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 deltachat-rpc-server /app/bin/deltachat-rpc-server"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://github.com/chatmail/core/releases/download/v2.64.0/deltachat-rpc-server-x86_64-linux",
                    "sha256": "399e865fa9621d666f18f1bab3700e7d2ddae1b8c0947d0792af33042b32d5fb",
                    "dest-filename": "deltachat-rpc-server",
                    "only-arches": [
                        "x86_64"
                    ],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/chatmail/core/releases/latest",
                        "timestamp-query": ".published_at",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"deltachat-rpc-server-x86_64-linux\") | .browser_download_url"
                    }
                },
                {
                    "type": "file",
                    "url": "https://github.com/chatmail/core/releases/download/v2.64.0/deltachat-rpc-server-aarch64-linux",
                    "sha256": "e02d462397c71daa661718a88fb0de20684850a3a4f1ae6794d189cdbb0ed914",
                    "dest-filename": "deltachat-rpc-server",
                    "only-arches": [
                        "aarch64"
                    ],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/chatmail/core/releases/latest",
                        "timestamp-query": ".published_at",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"deltachat-rpc-server-aarch64-linux\") | .browser_download_url"
                    }
                }
            ]
        },
        {
            "name": "libzip",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TOOLS=OFF",
                "-DBUILD_REGRESS=OFF",
                "-DBUILD_EXAMPLES=OFF",
                "-DBUILD_DOC=OFF",
                "-DENABLE_OPENSSL=ON",
                "-DENABLE_GNUTLS=OFF",
                "-DENABLE_MBEDTLS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://libzip.org/download/libzip-1.12.1.tar.xz",
                    "sha256": "c40062022a1963c80573d48f6070792297cecd7c6bffe3aefcac0d8b9bee8913"
                }
            ]
        },
        {
            "name": "parla",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../.."
                }
            ]
        }
    ]
}
