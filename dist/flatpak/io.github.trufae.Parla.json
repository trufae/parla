{
    "id": "io.github.trufae.Parla",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "parla",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio"
    ],
    "modules": [
        {
            "name": "deltachat-rpc-server",
            "buildsystem": "simple",
            "build-commands": [
                "install -Dm755 deltachat-rpc-server /app/bin/deltachat-rpc-server"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://github.com/chatmail/core/releases/download/v2.69.0/deltachat-rpc-server-x86_64-linux",
                    "sha256": "db1a2c08375c9c2e73c8d6009cc99094e642722a41d06370cdb4dc680247eaa0",
                    "dest-filename": "deltachat-rpc-server",
                    "only-arches": [
                        "x86_64"
                    ],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/chatmail/core/releases/latest",
                        "timestamp-query": ".published_at",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"deltachat-rpc-server-x86_64-linux\") | .browser_download_url"
                    }
                },
                {
                    "type": "file",
                    "url": "https://github.com/chatmail/core/releases/download/v2.69.0/deltachat-rpc-server-aarch64-linux",
                    "sha256": "206beb5ff18ed1cb2929f822dee95fed4d1793a1bbdffecb1925793d8fd4b978",
                    "dest-filename": "deltachat-rpc-server",
                    "only-arches": [
                        "aarch64"
                    ],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/chatmail/core/releases/latest",
                        "timestamp-query": ".published_at",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"deltachat-rpc-server-aarch64-linux\") | .browser_download_url"
                    }
                }
            ]
        },
        {
            "name": "parla",
            "buildsystem": "meson",
            "config-opts": [
                "-Dupdate_checks=false"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../.."
                }
            ]
        }
    ]
}
