<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.trufae.Parla</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0</project_license>
  <name>Parla</name>
  <summary>A Delta Chat client for GNOME</summary>
  <description>
    <p>Parla is a Delta Chat client for GNOME.</p>
    <p>Chat over email, decentralized and encrypted.</p>
  </description>
  <launchable type="desktop-id">io.github.trufae.Parla.desktop</launchable>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/trufae/parla/main/data/screenshots/welcome.png</image>
      <caption>Welcome</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/trufae/parla/main/data/screenshots/welcome-dark.png</image>
      <caption>Dark Theme</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/trufae/parla</url>
  <url type="bugtracker">https://github.com/trufae/parla/issues</url>
  <url type="vcs-browser">https://github.com/trufae/parla</url>
  <developer id="io.github.trufae">
    <name translate="no">pancake</name>
  </developer>
